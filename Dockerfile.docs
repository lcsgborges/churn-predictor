# Imagem só da documentação (MkDocs) — para servir a doc na VPS (EasyPanel) como
# um serviço separado, ex.: docs.seudominio.com. Build context = 1-1_lucas_guimaraes.
FROM python:3.12-slim AS build
WORKDIR /docs
COPY requirements-docs.txt .
RUN pip install --no-cache-dir -r requirements-docs.txt
COPY mkdocs.yml .
COPY docs/ docs/
RUN mkdocs build --strict

FROM nginx:alpine
COPY --from=build /docs/site /usr/share/nginx/html
EXPOSE 80
