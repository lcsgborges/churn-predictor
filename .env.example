# Copie para .env e preencha. NUNCA comite o .env real.

# Chave da OpenAI (obrigatória para o raciocínio do agente).
# Sem ela, o sistema opera 100% em modo FALLBACK (só o modelo ML + explicação template).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo do agente. gpt-4o-mini: barato, rápido, bom para raciocínio estruturado.
OPENAI_MODEL=gpt-4o-mini

# Timeout (segundos) por chamada ao LLM antes de acionar o fallback.
LLM_TIMEOUT_SECONDS=20

# URL base da API que o produto (Streamlit) consome.
# Local/Docker: através do nginx em /api. Ajuste se rodar a API separada.
API_BASE_URL=http://localhost:8000

# Caminho do log de traces (monitoramento).
TRACE_LOG_PATH=monitoring/traces.jsonl
